# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채웁니다. (.env.local 은 Git에 올라가지 않습니다)

# Supabase 연결 주소. 비워 두면 PC 안의 내장 데이터베이스(.pglite 폴더)를 씁니다.
# Supabase 대시보드 → Connect → "Transaction pooler" 주소(포트 6543)를 붙여 넣고 [YOUR-PASSWORD]를 실제 비밀번호로 바꿉니다.
DATABASE_URL=

# 개발·시연용 임시 로그인(계정 선택). 운영 전환 시 false
DEV_LOGIN=true

# 전날 알림 시각(한국 시간). Vercel 배포 시 vercel.json 의 cron 시각(UTC)도 함께 맞춥니다.
DAILY_NOTIFY_TIME=17:00

# Vercel Cron 이 /api/cron/daily 를 부를 때 쓰는 비밀값. Vercel 환경변수에 아무 긴 문자열로 넣습니다.
CRON_SECRET=

# 군 메일·알림톡 연동(X2·X3). false 이면 테스트 모드(기록만)
# 연동 규격을 받으면 src/lib/notifier.ts 의 어댑터를 규격에 맞게 바꿉니다.
MAIL_ENABLED=false
MAIL_ENDPOINT=
ALIMTALK_ENABLED=false
ALIMTALK_ENDPOINT=
